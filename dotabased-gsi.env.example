# Copy this file to dotabased-gsi.env and edit values as needed.
# Values in your shell or Windows environment take precedence over this file.

DOTABASED_GSI_HOST=127.0.0.1
DOTABASED_GSI_PORT=3100
DOTABASED_GSI_TOKEN=dotabased-local-gsi
DOTABASED_GSI_STALE_AFTER_MS=5000
DOTABASED_PYTHON=python
DOTABASED_PREDICTION_DIR=.\dotaprediction
DOTABASED_PREDICT_TIMEOUT_MS=2000

# Advanced overrides:
# DOTABASED_SCORER_EXE=C:\path\to\scorer.exe
